# Copy this file to .env.local (web) or .env (CLI tools). Never commit real values.
NODE_ENV=development
# On Vercel, set this separately for Preview and Production. If omitted,
# Motionly derives it from VERCEL_ENV.
APP_ENV=local
# Production must use the final custom HTTPS origin. Preview deployments can
# derive their branch/deployment origin from Vercel system variables.
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Local default: mongodb://localhost:27017. Use a separate database per environment.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=motionly
# Optional: use public DNS when the local/ISP resolver cannot resolve Atlas SRV records.
MONGODB_DNS_SERVERS=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_NAME=Motionly Indian Educator

# Private Cloudflare R2 media storage. Configure all five values together.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=motionly-ai-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Rendering stays local for local/test environments. Preview and production
# always use detached Vercel Sandbox. Set this locally only when intentionally
# exercising the hosted provider with pulled Vercel credentials.
VIDEO_RENDER_PROVIDER=
# Connect a private Vercel Blob store to the web project. Sandbox uses it only
# as a temporary handoff before the completed MP4 is copied into private R2.
BLOB_READ_WRITE_TOKEN=
# Use "free-license" only while the project qualifies under Remotion's terms.
REMOTION_LICENSE_KEY=

# Reserved for later phases. Keep unset until those integrations are implemented.
BETTER_AUTH_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@your-verified-domain.com
# Comma-separated verified accounts allowed to open /admin/media.
MOTIONLY_ADMIN_EMAILS=

# Meta Instagram Unified Login. The redirect URI must exactly match Meta.
META_APP_ID=
META_APP_SECRET=
META_INSTAGRAM_CONFIG_ID=
META_INSTAGRAM_REDIRECT_URI=https://your-domain.com/api/v1/integrations/instagram/oauth/callback
META_GRAPH_VERSION=v27.0
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
SENTRY_DSN=
