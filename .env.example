# Copy this file to .env.local (web) or .env (CLI tools). Never commit real values.
NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Local default: mongodb://localhost:27017. Use a separate database per environment.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=motionly
# Optional: use public DNS when the local/ISP resolver cannot resolve Atlas SRV records.
MONGODB_DNS_SERVERS=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_NAME=Motionly Indian Educator

# Reserved for later phases. Keep unset until those integrations are implemented.
BETTER_AUTH_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@your-verified-domain.com
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
SENTRY_DSN=
