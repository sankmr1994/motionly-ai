{
  "name": "@motionly/video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "studio": "remotion studio src/register.ts",
    "render:solar": "remotion render src/register.ts MotionlyExplainer ../../out/solar-eclipse.mp4",
    "render:solar:narrated": "remotion render src/register.ts MotionlyExplainer ../../out/solar-eclipse-narrated.mp4 --props=../../storage/solar-eclipse/render-props.json",
    "render:compound:narrated": "remotion render src/register.ts MotionlyExplainer ../../out/compound-interest-narrated.mp4 --props=../../storage/compound-interest/render-props.json",
    "render:binary-search:narrated": "remotion render src/register.ts MotionlyExplainer ../../out/binary-search-narrated.mp4 --props=../../storage/binary-search/render-props.json",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@motionly/shared": "workspace:*",
    "@remotion/cli": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2"
  }
}
